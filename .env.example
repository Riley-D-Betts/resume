# Local dev only — production runs on Cloudflare Workers, where secrets are
# set with `npx wrangler secret put <NAME>` and plain vars live in
# wrangler.jsonc ("vars"). Every plain var below is mirrored there.
#
# `npm run dev` works with NO env at all (password 'dev' for /ops). Set these
# only to exercise the production auth paths locally.

# Password for the /ops admin console (secret).
#NUXT_ADMIN_PASSWORD=

# Secret used to sign the admin session cookie and the replay upload token.
# 32+ characters required. Generate one:  openssl rand -hex 32
#NUXT_SESSION_PASSWORD=

# Trust x-real-ip / x-forwarded-for when cf-connecting-ip is absent. Default
# true. Only matters off Cloudflare (nuxt dev, another host) — set false there
# if the app is reachable without a trusted reverse proxy in front of it.
#NUXT_TRUST_PROXY=true

# Anonymize IPs before storing (zero the last IPv4 octet / truncate IPv6 to
# its /48). Geo comes from Cloudflare's request metadata either way. Also
# disables reverse DNS. Default false.
#NUXT_IP_ANONYMIZE=true

# Fraction of sessions that get rrweb replay recording, 0..1. Default 1.
#NUXT_PUBLIC_REPLAY_SAMPLE_RATE=0.5

# Retention, in days — enforced by the daily cron trigger (wrangler.jsonc).
# Replay chunks in R2 + their D1 rows. Default 30.
#NUXT_REPLAY_RETENTION_DAYS=30
# events + page_perf rows. Default 180 (lower it if /ops shows D1 near 500 MB).
#NUXT_EVENT_RETENTION_DAYS=180
# page_visits, session_env, session_net rows. Default 365.
#NUXT_SIDE_TABLE_RETENTION_DAYS=365
# After this many days ip / ua / lat / lon are nulled on sessions. Default 365.
#NUXT_PII_RETENTION_DAYS=365
# 0 = keep sessions + visitors forever (counters only after the PII scrub);
# > 0 deletes whole sessions older than this. Default 0.
#NUXT_SESSION_RETENTION_DAYS=0

# Global Privacy Control / DNT are always recorded per session. Set BOTH to
# true to honour them: the server drops GPC/DNT envelopes, the client does not
# start the tracker. Default false.
#NUXT_HONOR_GPC=false
#NUXT_PUBLIC_HONOR_GPC=false

# Reverse DNS of the session IP via Cloudflare DoH (cached in rdns_cache).
# Ignored while NUXT_IP_ANONYMIZE=true. Default false.
#NUXT_RDNS_ENABLED=false
