# Local dev only — production runs on Cloudflare Workers, where secrets are
# set with `npx wrangler secret put <NAME>` and plain vars in wrangler.jsonc.
#
# `npm run dev` works with NO env at all (password 'dev' for /ops). Set these
# only to exercise the production auth paths locally.

# Password for the /ops admin console.
#NUXT_ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. 32+ characters required.
# Generate one:  openssl rand -hex 32
#NUXT_SESSION_PASSWORD=

# Anonymize IPs before storing (zero the last IPv4 octet / truncate IPv6
# to its /48). Geo comes from Cloudflare's request metadata either way.
#NUXT_IP_ANONYMIZE=true

# Fraction of sessions that get rrweb replay recording, 0..1. Default 1.
#NUXT_PUBLIC_REPLAY_SAMPLE_RATE=0.5

# Retention, in days — enforced by the daily cron trigger (wrangler.jsonc).
#NUXT_REPLAY_RETENTION_DAYS=30
#NUXT_EVENT_RETENTION_DAYS=180
