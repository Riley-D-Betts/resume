{
  "name": "riley-betts-ops-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply resume-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply resume-analytics --remote",
    "postinstall": "nuxt prepare",
    "seed": "node scripts/seed-visit.mjs",
    "test:e2e": "playwright test -c tests"
  },
  "dependencies": {
    "nuxt": "^4.5.0",
    "rrweb": "^2.1.1",
    "rrweb-player": "^2.1.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@nuxt/fonts": "^0.14.0",
    "@playwright/test": "^1.56.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^5.6.0",
    "wrangler": "^4"
  }
}
